# ---- required ----
# 32 random bytes, base64. Encrypts saved TikTok passwords and sessions. Losing it = losing every saved account.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=
# Owner created on the very first start (only used while the users table is empty). The panel forces a change at first login.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# ---- deployment ----
ZALIV_PORT=8120
COOKIE_SECURE=true
TRUST_PROXY=true

# ---- browser ----
BROWSER_HEADLESS=true
BROWSER_MAX_INTERACTIVE=6
BROWSER_MAX_BACKGROUND=3
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=Europe/Kyiv

# ---- sync ----
AUTO_SYNC=false
SYNC_INTERVAL_MIN=60
SYNC_MAX_AD_ACCOUNTS=100

# ---- TikTok (override only for tests) ----
# TIKTOK_ADS_ORIGIN=https://ads.tiktok.com
